{
  "name": "wire-ui",
  "displayName": "Wire UI",
  "description": "Editor intelligence for Wire UI — autocomplete, hover docs, snippets, and lints for the AI-native unstyled primitives framework",
  "version": "0.0.0",
  "private": true,
  "publisher": "wire-ui",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "homepage": "https://wire-ui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wire-ui/wire-ui.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/wire-ui/wire-ui/issues"
  },
  "keywords": [
    "wire-ui",
    "ai-native",
    "headless",
    "components",
    "react",
    "vue",
    "solid"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.19.0"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@wire-ui/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "commands": [
      {
        "command": "wire-ui.init",
        "title": "Init",
        "category": "Wire UI"
      },
      {
        "command": "wire-ui.addComponent",
        "title": "Add Component",
        "category": "Wire UI"
      },
      {
        "command": "wire-ui.openPlayground",
        "title": "Open Playground",
        "category": "Wire UI"
      },
      {
        "command": "wire-ui.mcpStatus",
        "title": "MCP Server Status",
        "category": "Wire UI"
      },
      {
        "command": "wire-ui.showOutput",
        "title": "Show Output Log",
        "category": "Wire UI"
      }
    ],
    "configuration": {
      "title": "Wire UI",
      "properties": {
        "wire-ui.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Wire UI editor intelligence (autocomplete, hover docs, diagnostics)."
        },
        "wire-ui.snippets.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Add the matching @wire-ui import when a component or hook snippet is inserted. Scaffolds always bring their own imports."
        },
        "wire-ui.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication with the Wire UI TypeScript Language Service plugin."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "package": "vsce package --no-dependencies",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wire-ui/typescript-plugin": "*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
