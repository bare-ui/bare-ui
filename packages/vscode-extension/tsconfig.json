{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "preserve",
		"types": ["node", "vscode"],
		"skipLibCheck": true,

		/* Bundler mode (tsup/esbuild handles the CJS emit) */
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"noEmit": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["src"]
}
