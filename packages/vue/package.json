{
	"name": "@wire-ui/vue",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"main": "./dist/wire-ui-vue.cjs.js",
	"module": "./dist/wire-ui-vue.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/wire-ui-vue.es.js",
			"require": "./dist/wire-ui-vue.cjs.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"description": "AI-native unstyled primitives for your design system. Headless, compound components with zero CSS — style via data-* attributes. Vue 3 edition.",
	"sideEffects": false,
	"homepage": "https://wire-ui.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/wire-ui/wire-ui.git",
		"directory": "packages/vue"
	},
	"bugs": {
		"url": "https://github.com/wire-ui/wire-ui/issues"
	},
	"keywords": [
		"vue",
		"vue3",
		"headless",
		"unstyled",
		"components",
		"ui",
		"accessible",
		"ai-native",
		"compound-components",
		"data-attributes",
		"design-system"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "vue-tsc -b tsconfig.build.json && vite build",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build",
		"format": "prettier --write \"src/**/*.{ts,vue}\"",
		"test": "vitest --config vitest.config.ts",
		"test:run": "vitest run --config vitest.config.ts",
		"test:coverage": "vitest run --coverage --config vitest.config.ts",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"vue": ">=3.5.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.1",
		"@eslint/js": "^9.39.4",
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-vitest": "^10.3.3",
		"@storybook/vue3-vite": "^10.3.3",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/vue": "^8.1.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.12.0",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.3",
		"globals": "^17.4.0",
		"jsdom": "^29.0.1",
		"prettier": "^3.8.1",
		"storybook": "^10.3.3",
		"tailwindcss": "^4.2.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.1",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.1.2",
		"vue": "^3.5.16",
		"vue-tsc": "^2.2.12"
	}
}
