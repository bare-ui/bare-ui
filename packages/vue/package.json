{
	"name": "@wire-ui/vue",
	"version": "0.4.0",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"description": "AI-native unstyled primitives for your design system. Headless, compound components with zero CSS — style via data-* attributes. Vue 3 edition.",
	"sideEffects": false,
	"homepage": "https://wire-ui.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/wire-ui/wire-ui.git",
		"directory": "packages/vue"
	},
	"bugs": {
		"url": "https://github.com/wire-ui/wire-ui/issues"
	},
	"keywords": [
		"vue",
		"vue3",
		"headless",
		"unstyled",
		"components",
		"ui",
		"accessible",
		"ai-native",
		"compound-components",
		"data-attributes",
		"design-system"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "vue-tsc -b tsconfig.build.json && vite build",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"typecheck": "vue-tsc -b",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build",
		"format": "prettier --write \"src/**/*.{ts,vue}\"",
		"test": "vitest --config vitest.config.ts",
		"test:run": "vitest run --config vitest.config.ts",
		"test:unit": "vitest run --project unit --config vitest.config.ts",
		"test:sr": "vitest run --project unit --config vitest.config.ts .sr.test",
		"test:a11y": "vitest run --project storybook --config vitest.config.ts",
		"test:ssr": "vitest run --config vitest.ssr.config.ts",
		"test:hydrate": "vitest run --config vitest.ssr.config.ts && vitest run --config vitest.hydrate.config.ts",
		"test:coverage": "vitest run --project unit --coverage --config vitest.config.ts",
		"bench": "vitest bench --run --config vitest.bench.config.ts",
		"bench:mount": "vitest bench --run --config vitest.bench.config.ts bench/render.mount.bench.ts",
		"bench:ssr": "vitest bench --run --config vitest.bench.config.ts bench/render.ssr.bench.ts",
		"size": "size-limit",
		"attw": "attw --pack .",
		"compiler:check": "node scripts/compiler-check.mjs",
		"license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;MIT-0;BlueOak-1.0.0' --summary",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"vue": ">=3.5.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@chromatic-com/storybook": "^5.1.1",
		"@headlessui/vue": "^1.7.0",
		"@size-limit/preset-small-lib": "^12.1.0",
		"@eslint/js": "^9.39.4",
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-vitest": "^10.3.3",
		"@storybook/vue3-vite": "^10.3.3",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/user-event": "^14.6.1",
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^24.12.0",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vue/server-renderer": "^3.5.0",
		"@vitest/browser-playwright": "^4.1.2",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.3",
		"eslint-plugin-vue": "^10.9.1",
		"globals": "^17.4.0",
		"jsdom": "^29.0.1",
		"license-checker-rseidelsohn": "^5.0.1",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"radix-vue": "^1.9.0",
		"size-limit": "^12.1.0",
		"storybook": "^10.3.3",
		"tailwindcss": "^4.2.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.1",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.1.2",
		"vue": "^3.5.16",
		"vue-eslint-parser": "^10.4.0",
		"vue-tsc": "^2.2.12"
	}
}
