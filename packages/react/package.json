{
	"name": "@wire-ui/react",
	"version": "0.4.0",
	"license": "MIT",
	"type": "module",
	"main": "./dist/wire-ui.cjs.js",
	"module": "./dist/wire-ui.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/wire-ui.es.js",
			"require": "./dist/wire-ui.cjs.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"description": "AI-native unstyled primitives for your design system. Headless, compound components with zero CSS — style via data-* attributes.",
	"sideEffects": false,
	"homepage": "https://wire-ui.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/wire-ui/wire-ui.git",
		"directory": "packages/react"
	},
	"bugs": {
		"url": "https://github.com/wire-ui/wire-ui/issues"
	},
	"keywords": [
		"react",
		"headless",
		"unstyled",
		"components",
		"ui",
		"accessible",
		"ai-native",
		"compound-components",
		"data-attributes",
		"design-system"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "tsc -b && vite build",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "vitest --config vitest.config.ts",
		"test:run": "vitest run --config vitest.config.ts",
		"test:unit": "vitest run --project unit --config vitest.config.ts",
		"test:a11y": "vitest run --project storybook --config vitest.config.ts",
		"test:coverage": "vitest run --project unit --coverage --config vitest.config.ts",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.1",
		"@eslint/js": "^9.39.4",
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-vitest": "^10.3.3",
		"@storybook/react-vite": "^10.3.3",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser-playwright": "^4.1.2",
		"@vitest/coverage-v8": "^4.1.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"eslint-plugin-storybook": "^10.3.3",
		"globals": "^17.4.0",
		"jsdom": "^29.0.1",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"storybook": "^10.3.3",
		"tailwindcss": "^4.2.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.1",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.1.2"
	}
}
