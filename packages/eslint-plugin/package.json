{
  "name": "@wire-ui/eslint-plugin",
  "version": "0.0.0",
  "description": "ESLint rules for Wire UI — catches compound-component misuse using the same metadata catalog as the VS Code extension",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://wire-ui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wire-ui/wire-ui.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/wire-ui/wire-ui/issues"
  },
  "keywords": [
    "wire-ui",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "ai-native",
    "headless",
    "components"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.58.1",
    "@wire-ui/typescript-plugin": "*"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^9.39.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
