{
  "name": "@wire-ui/typescript-plugin",
  "version": "0.0.0",
  "description": "TypeScript Language Service plugin powering Wire UI editor intelligence — the shared brain behind the VS Code extension and other editors",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "require": "./dist/metadata.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://wire-ui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wire-ui/wire-ui.git",
    "directory": "packages/typescript-plugin"
  },
  "bugs": {
    "url": "https://github.com/wire-ui/wire-ui/issues"
  },
  "keywords": [
    "wire-ui",
    "typescript",
    "tsserver",
    "language-service-plugin",
    "ai-native",
    "headless",
    "components"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wire-ui/mcp": "*"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
